obo:FOODON_03310765 a hlth:FoodItem ;
    rdfs:label "Leafy Greens"@en ;
    obo:IAO_0000115 "A plant leaf vegetable food product which is a bunch of raw leaves."@en ;
    hlth:confidence "gold"^^xsd:string ;
    hlth:contains_ingredient local:edible_leaves_and_stems_of_plants ;
    hlth:sourceOntology "FOODON"^^xsd:string ;
    hlth:source_doc "health&nutrition_osteoarthritis_infosheet.pdf"^^xsd:string ;
    rdfs:comment "A plant leaf vegetable food product which is a bunch of raw leaves."@en ;
