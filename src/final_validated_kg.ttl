    prov:wasDerivedFrom doc:health%26nutrition_osteoarthritis_infosheet .

hlth:advises_caution_for a owl:ObjectProperty ;
    rdfs:domain hlth:PhysicalActivity ;
    rdfs:range hlth:Condition .

hlth:can_lead_to a owl:ObjectProperty ;
    rdfs:domain hlth:Condition ;
    rdfs:range hlth:Condition .

hlth:contains_ingredient a owl:ObjectProperty ;
    rdfs:domain hlth:FoodItem ;
    rdfs:range hlth:FoodItem .

hlth:contains_nutrient a owl:ObjectProperty ;
    rdfs:domain hlth:FoodItem ;
    rdfs:range hlth:Nutrient .

hlth:has_description a owl:ObjectProperty ;
    rdfs:domain hlth:Condition ;
    rdfs:range hlth:Description .

hlth:has_symptom a owl:ObjectProperty ;
    rdfs:domain hlth:Condition ;
    rdfs:range hlth:Symptom .

hlth:helps_manage a owl:ObjectProperty ;
    rdfs:domain hlth:PhysicalActivity ;
    rdfs:range hlth:Condition .

hlth:is_a_type_of a owl:ObjectProperty ;
    rdfs:domain hlth:FoodItem ;
    rdfs:range hlth:FoodItem .

hlth:limits a owl:ObjectProperty ;
    rdfs:domain hlth:Diet ;
    rdfs:range hlth:FoodItem .

hlth:limits_food a owl:ObjectProperty ;
    rdfs:domain hlth:Diet ;
    rdfs:range hlth:FoodItem .

hlth:managed_by a owl:ObjectProperty ;
    rdfs:domain hlth:Condition .

hlth:may_cause_symptom a owl:ObjectProperty ;
    rdfs:domain hlth:PhysicalActivity ;
    rdfs:range hlth:Symptom .

hlth:recommends a owl:ObjectProperty ;
    rdfs:domain hlth:Diet ;
    rdfs:range hlth:FoodItem .

hlth:recommends_food a owl:ObjectProperty ;
    rdfs:domain hlth:Diet ;
    rdfs:range hlth:FoodItem .

hlth:should_avoid a owl:ObjectProperty ;
    rdfs:domain hlth:Condition ;
    rdfs:range hlth:FoodItem .

hlth:should_avoid_food a owl:ObjectProperty ;
    rdfs:domain hlth:Condition ;
    rdfs:range hlth:FoodItem .

hlth:source_doc a owl:DatatypeProperty ;
    rdfs:range xsd:string .

