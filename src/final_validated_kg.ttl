obo:EXMO_0000183 a hlth:PhysicalActivity ;
    rdfs:label "Gentle Walking"@en ;
    obo:IAO_0000115 "Moderate walking refers to brisk walking at a pace that increases heart rate and breathing noticeably but still allows for comfortable conversation."@en ;
    rdfs:comment "Moderate walking refers to brisk walking at a pace that increases heart rate and breathing noticeably but still allows for comfortable conversation."@en .

