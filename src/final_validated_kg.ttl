obo:DOID_0051061 a hlth:Condition ;
    rdfs:label "Stroke"@en ;
    obo:IAO_0000115 "A cerebrovascular disease that is characterized by disruption of blood flow to the brain resulting in damage to brain cells due to a lack of oxygen."@en ;
    rdfs:comment "A cerebrovascular disease that is characterized by disruption of blood flow to the brain resulting in damage to brain cells due to a lack of oxygen."@en .

