    rdfs:label "Eggs"@en ;
    obo:IAO_0000115 "A food product made from an avian egg."@en ;
    rdfs:comment "A food product made from an avian egg."@en .

obo:FOODON_00002689 a hlth:Diet ;
    rdfs:label "Tropical Fruit"@en ;
