    rdfs:comment "The act of propelling the body through water by movement of the arms and/or legs."@en .

obo:SYMP_0000006 a hlth:Symptom ;
    rdfs:label "Back Pain"@en ;
    obo:IAO_0000115 "A pain that is characterized by occurring in the lower back."@en ;
    rdfs:comment "A pain that is characterized by occurring in the lower back."@en .

obo:SYMP_0000441 a hlth:Symptom ;
    rdfs:label "Elbow Pain"@en ;
    obo:IAO_0000115 "A joint pain that is characterized by a pain situated, or occurring, in or around the elbow."@en ;
    rdfs:comment "A joint pain that is characterized by a pain situated, or occurring, in or around the elbow."@en .

obo:SYMP_0000442 a hlth:Symptom ;
