obo:FOODON_03411150 a hlth:FoodItem ;
    rdfs:label "Nderema"@en ;
    obo:IAO_0000115 "A fast-growing leafy climbing plant."@en ;
    hlth:confidence "gold"^^xsd:string ;
    hlth:is_a_type_of local:spinach ;
    hlth:sourceOntology "LOCAL"^^xsd:string ;
    hlth:source_doc "health&nutrition_osteoarthritis_infosheet.pdf"^^xsd:string ;
    rdfs:comment "A fast-growing leafy climbing plant."@en ;
    prov:wasDerivedFrom doc:health%26nutrition_osteoarthritis_infosheet .

obo:FOODON_03413409 a hlth:FoodItem ;
    rdfs:label "Managu"@en ;
    obo:IAO_0000115 "Solanum nigrum (European Black Nightshade or locally just \"black nightshade\", Duscle, Garden Nightshade, Hound's Berry, Petty Morel, Wonder Berry, Small-fruited black nightshade or popolo) is a species in the *Solanum* genus, native to Eurasia and introduced in the Americas, Australasia and South Africa. Parts of this plant can be highly toxic to livestock and humans, and it's considered a weed. Nonetheless, ripe berries and cooked leaves of edible strains are used as food in some locales; and plant parts are used as a traditional medicine."@en ;
    hlth:confidence "gold"^^xsd:string ;
    hlth:is_a_type_of local:spinach ;
    hlth:sourceOntology "FOODON"^^xsd:string ;
    hlth:source_doc "health&nutrition_osteoarthritis_infosheet.pdf"^^xsd:string ;
    rdfs:comment "Solanum nigrum (European Black Nightshade or locally just \"black nightshade\", Duscle, Garden Nightshade, Hound's Berry, Petty Morel, Wonder Berry, Small-fruited black nightshade or popolo) is a species in the *Solanum* genus, native to Eurasia and introduced in the Americas, Australasia and South Africa. Parts of this plant can be highly toxic to livestock and humans, and it's considered a weed. Nonetheless, ripe berries and cooked leaves of edible strains are used as food in some locales; and plant parts are used as a traditional medicine."@en ;
    prov:wasDerivedFrom doc:health%26nutrition_osteoarthritis_infosheet .

obo:IAO_0000115 a owl:AnnotationProperty ;
    rdfs:label "definition"@en .

obo:NCIT_C21057 a hlth:PhysicalActivity ;
    rdfs:label "Static Stretches"@en ;
    obo:IAO_0000115 "An exercise that is performed by exerting force against an immovable object or by holding an object in a static position."@en ;
