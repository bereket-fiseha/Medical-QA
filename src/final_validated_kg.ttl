    rdfs:comment "A joint pain that is characterized by a pain situated, or occurring, in or around the knee."@en .

obo:SYMP_0000458 a hlth:Symptom ;
    rdfs:label "Nausea"@en ;
    obo:IAO_0000115 "Nausea is a digestive system symptom characterized by an uneasy or unsettled feeling in the stomach together with an urge to vomit."@en ;
    rdfs:comment "Nausea is a digestive system symptom characterized by an uneasy or unsettled feeling in the stomach together with an urge to vomit."@en .

obo:SYMP_0000504 a hlth:Symptom ;
