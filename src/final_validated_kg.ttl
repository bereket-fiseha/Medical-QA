obo:DOID_13189 a hlth:Condition ;
    rdfs:label "Gout"@en ;
    obo:IAO_0000115 "An arthritis that has_material_basis_in uric acid crystal deposits located_in joint."@en ;
    hlth:confidence "silver"^^xsd:string ;
    hlth:should_avoid local:beer,
        local:spinach,
        local:tomatoes,
        obo:FOODON_03400794 ;
    hlth:sourceOntology "DOID"^^xsd:string ;
    hlth:source_doc "arthritis_article_cpdh.pdf"^^xsd:string ;
    rdfs:comment "An arthritis that has_material_basis_in uric acid crystal deposits located_in joint."@en ;
    prov:wasDerivedFrom doc:arthritis_article_cpdh .

obo:DOID_7148 a hlth:Condition ;
    rdfs:label "Rheumatoid Arthritis"@en ;
    obo:IAO_0000115 "An arthritis that is an autoimmune disease which attacks healthy cells and tissue located_in joint."@en ;
    hlth:can_lead_to local:severe_joint_damage,
        obo:DOID_114 ;
    hlth:confidence "gold"^^xsd:string,
        "silver"^^xsd:string ;
    hlth:has_symptom local:chronic_pain,
        local:joint_stiffness,
        local:loss_of_appetite,
        local:pain,
        local:poor_sleep_quality,
        local:swelling_in_the_joints,
        obo:SYMP_0000064,
        obo:SYMP_0000538 ;
    hlth:sourceOntology "DOID"^^xsd:string ;
    hlth:source_doc "arthritis_article_cpdh.pdf"^^xsd:string,
        "health&nutrition_autoimmune_conditions_infosheet.pdf"^^xsd:string ;
    rdfs:comment "An arthritis that is an autoimmune disease which attacks healthy cells and tissue located_in joint."@en ;
    prov:wasDerivedFrom doc:arthritis_article_cpdh,
        doc:health%26nutrition_autoimmune_conditions_infosheet .

obo:DOID_9074 a hlth:Condition ;
    rdfs:label "Lupus"@en ;
    obo:IAO_0000115 "A lupus erythematosus that is an inflammation of connective tissue marked by skin rashes, joint pain and swelling, inflammation of the kidneys and inflammation of the tissue surrounding the heart."@en ;
    hlth:can_lead_to local:severe_organ_damage ;
    hlth:confidence "gold"^^xsd:string ;
    hlth:has_symptom local:butterfly_shaped_rash_across_the_face,
        local:chest_pain,
        local:fever,
        local:joint_stiffness,
        local:rashes_on_other_parts_of_the_body,
        local:shortness_of_breath,
        local:tiredness,
        obo:SYMP_0000064 ;
    hlth:sourceOntology "DOID"^^xsd:string ;
    hlth:source_doc "health&nutrition_autoimmune_conditions_infosheet.pdf"^^xsd:string ;
    rdfs:comment "A lupus erythematosus that is an inflammation of connective tissue marked by skin rashes, joint pain and swelling, inflammation of the kidneys and inflammation of the tissue surrounding the heart."@en ;
    prov:wasDerivedFrom doc:health%26nutrition_autoimmune_conditions_infosheet .

obo:EXMO_0000166 a hlth:PhysicalActivity ;
    rdfs:label "Dynamic Stretches"@en ;
    obo:IAO_0000115 "Aerobics is a form of physical exercise that combines rhythmic aerobic exercise with stretching and strength training routines with the goal of improving all elements of fitness (flexibility, muscular strength, and cardio-vascular fitness)."@en ;
    hlth:confidence "gold"^^xsd:string ;
    hlth:helps_manage obo:DOID_8398 ;
    hlth:sourceOntology "EXMO"^^xsd:string ;
    hlth:source_doc "health&nutrition_osteoarthritis_infosheet.pdf"^^xsd:string ;
    rdfs:comment "Aerobics is a form of physical exercise that combines rhythmic aerobic exercise with stretching and strength training routines with the goal of improving all elements of fitness (flexibility, muscular strength, and cardio-vascular fitness)."@en ;
    prov:wasDerivedFrom doc:health%26nutrition_osteoarthritis_infosheet .

obo:FOODON_00003108 a hlth:FoodItem ;
    rdfs:label "Barley"@en ;
    obo:IAO_0000115 "Barley is a cultivated grain used as animal fodder, as a source of fermentable material for beer and certain distilled beverages, and as a component of various health foods. It is used in soups and stews, and in barley bread of various cultures. Barley grains are commonly made into malt in a traditional and ancient method of preparation."@en ;
    hlth:confidence "gold"^^xsd:string ;
    hlth:is_a_type_of local:healthy_grains ;
    hlth:sourceOntology "FOODON"^^xsd:string ;
    hlth:source_doc "health&nutrition_type2diabetes_infosheet.pdf"^^xsd:string ;
    rdfs:comment "Barley is a cultivated grain used as animal fodder, as a source of fermentable material for beer and certain distilled beverages, and as a component of various health foods. It is used in soups and stews, and in barley bread of various cultures. Barley grains are commonly made into malt in a traditional and ancient method of preparation."@en ;
    prov:wasDerivedFrom doc:health%26nutrition_type2diabetes_infosheet .

