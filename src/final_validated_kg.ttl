obo:FOODON_00004677 a hlth:FoodItem ;
    rdfs:label "White Rice"@en ;
    obo:IAO_0000115 "A cooked endosperm of a white rice plant."@en ;
    rdfs:comment "A cooked endosperm of a white rice plant."@en .

obo:FOODON_03310288 a hlth:FoodItem ;
    rdfs:label "Ugali"@en ;
    obo:IAO_0000115 "A type of maize flour porridge made in Africa."@en ;
    rdfs:comment "A type of maize flour porridge made in Africa."@en .

obo:FOODON_03420108 a hlth:FoodItem ;
    rdfs:label "Sugar"@en ;
    obo:IAO_0000115 "A broad term that includes the nutritive sweeteners dextrose, fructose, galactose, lactose, maltose and sucrose, which are simple carbohydrates with molecules composed of one or two saccharide units. Note that on a product label or in a recipe, 'sugar' means *SUCROSE* and should be so indexed. Use the broad term *SUGAR* only if the specific sugar used is not known or not listed in the vocabulary."@en ;
    rdfs:comment "A broad term that includes the nutritive sweeteners dextrose, fructose, galactose, lactose, maltose and sucrose, which are simple carbohydrates with molecules composed of one or two saccharide units. Note that on a product label or in a recipe, 'sugar' means *SUCROSE* and should be so indexed. Use the broad term *SUGAR* only if the specific sugar used is not known or not listed in the vocabulary."@en .

obo:NCIT_C172269 a hlth:PhysicalActivity ;
    rdfs:label "Dancing"@en ;
    obo:IAO_0000115 "A physical activity that consists of moving your feet and body rhythmically, usually in response to music."@en ;
    rdfs:comment "A physical activity that consists of moving your feet and body rhythmically, usually in response to music."@en .

obo:NCIT_C180667 a hlth:PhysicalActivity ;
    rdfs:label "Hiking"@en ;
    obo:IAO_0000115 "The activity of walking for recreation, exercise, or training that is usually strenuous and on unpaved surfaces."@en ;
    rdfs:comment "The activity of walking for recreation, exercise, or training that is usually strenuous and on unpaved surfaces."@en .

obo:NCIT_C85401 a hlth:PhysicalActivity ;
    rdfs:label "Cycling"@en ;
