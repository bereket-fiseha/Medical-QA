    rdfs:comment "A tuberous root tuber of a cassava plant (Manihot esculenta)."@en .

obo:FOODON_00004298 a hlth:FoodItem ;
    rdfs:label "Poultry"@en ;
    obo:IAO_0000115 "A whole poultry."@en ;
