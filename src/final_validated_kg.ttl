local:autoimmune_conditions a hlth:Condition ;
    rdfs:label "Autoimmune Conditions"@en ;
    hlth:confidence "gold"^^xsd:string ;
    hlth:should_avoid local:breads,
        local:chocolate,
        local:coffee,
        local:dairy,
        local:grains,
        local:nightshade_vegetables,
        local:processed_foods,
        obo:FOODON_00001105,
        obo:FOODON_00002753,
        obo:FOODON_03303171 ;
    hlth:source_doc "health&nutrition_autoimmune_conditions_infosheet.pdf"^^xsd:string ;
    prov:wasDerivedFrom doc:health%26nutrition_autoimmune_conditions_infosheet .

local:brown_rice a hlth:FoodItem ;
