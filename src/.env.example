# Copy this file to .env and fill in your values
# FastAPI will load it automatically via python-dotenv

# OpenAI API key — used by the KG/LLM placeholder (GPT-4o-mini)
# Leave blank to use the static placeholder response instead
OPENAI_API_KEY=sk-...your-key-here...

# (Optional) override the translation API URL
# TRANSLATE_API_URL=https://bereketfiseha123--translate-multilingual.modal.run
